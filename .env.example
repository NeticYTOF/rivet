# Copy to .env and fill in. Every variable is read once at startup by
# lib/config.js — a missing required value fails immediately with a list of
# what's absent, rather than degrading into silent fallbacks at answer time.
#
# On Railway these go in the service's Variables tab instead of a file.

# ─── required ────────────────────────────────────────────────────────────────

# Your Slack app's bot token. Slack app → OAuth & Permissions.
SLACK_BOT_TOKEN=xoxb-

# App-level token for Socket Mode, with the connections:write scope.
# Slack app → Basic Information → App-Level Tokens.
# Socket Mode means the bot dials out to Slack and listens on no port at all —
# no public URL, no tunnel, no domain needed.
SLACK_APP_TOKEN=xapp-

# Channel ID (not name) that always gets a reply to every top-level message.
# Right-click a channel in Slack → View channel details → ID at the bottom.
SLACK_HELP_CHANNEL=C0000000000

# Comma-separated channel IDs the bot watches. The FIRST entry is the
# auto-reply channel: the one where it answers without being mentioned.
SLACK_FAQ_CHANNELS=C0000000000,C1111111111

# Hack Club AI API key. Create it at https://ai.hackclub.com/.
HCAI_API_KEY=

# ─── your bot's identity ─────────────────────────────────────────────────────

# What the bot calls itself in every message it writes.
RIVET_BOT_NAME=rivet

# Command prefix. This one is load-bearing: it becomes every slash command
# (/sol, /sol-teach, /sol-gaps) and must match what your Slack app registers.
# Slash command names are unique per workspace, so if another bot in the same
# workspace already uses this prefix, the second app will fail to install.
RIVET_BOT_SLUG=rivet

# Slack user IDs allowed to teach the bot and see the maintainer commands.
# Fails CLOSED: empty means nobody can ever teach it anything. Put your own
# ID here.
RIVET_ADMIN_USER_IDS=

# ─── what the bot knows ──────────────────────────────────────────────────────

# The whole per-program config as one JSON value: channels, docs, posture,
# guides, dates. Set this and the repo's own programs.json is ignored entirely,
# which is what lets one unmodified copy of this repo serve any program.
#
# Source types: "url" (docs site, follows subpages), "github-dir" (GitHub
# contents API directory of markdown; add siteUrl for the rendered version),
# "json-faq" (inline "content", or a "url"), "text" (inline prose), and
# "live-shop" (the public Live reward catalogue).
#
# posture: "active" answers whenever it can, "passive" only when addressed,
#          "muted" stays silent (useful while setting up).
# scope:   "program" only answers questions about this program and leaves
#          everything else to the humans; "any" answers anything someone's
#          stuck on. Being pinged or DM'd bypasses either.
#
# Leave unset to fall back to programs.json in the repo root.
#
# RIVET_PROGRAMS_JSON=[{"id":"myprogram","name":"My Program","helpChannel":"C0000000000","channels":["C0000000000"],"posture":"active","scope":"program","guides":["submit-ysws-guidelines"],"sources":[{"name":"My Docs","type":"url","url":"https://example.com/docs"},{"name":"My FAQ","type":"json-faq","content":[{"question":"What is this?","answer":"A thing."}]}],"milestones":[{"name":"Launch","date":"2026-09-01"}]}]

# How often to re-fetch the docs, in minutes.
REFRESH_INTERVAL_MIN=30

# For doc sites that need JavaScript to render. Optional — plain HTML and
# markdown sources need nothing.
FIRECRAWL_API_KEY=

# ─── persistence ─────────────────────────────────────────────────────────────

# Where the SQLite file lives. On Railway, attach a volume and point this
# inside it — without one, every redeploy discards the answer cache, everything
# the bot has been taught, ticket records, and the last-good copy of the docs.
# RIVET_DB_PATH=/data/rivet.db

# ─── HCAI models (all optional) ──────────────────────────────────────────────

# All model calls use the single HCAI_API_KEY above. These only choose models
# for their respective tasks; leave them unset for the built-in defaults.
# HCAI_MODEL=openrouter/free
# HCAI_PING_MODEL=
# HCAI_HELP_MODEL=
# HCAI_INTENT_MODEL=
# HCAI_VISION_MODEL=xiaomi/mimo-v2-omni

# ─── Jev engagement classifier (all optional) ────────────────────────────────

# Jev — the engagement classifier ("should Rivet engage, and what kind of
# message is this?"). It never sees documentation and never decides whether
# Rivet can answer; retrieval + grounding do. Experiential Labs only, free
# model only, one bounded request, no provider/model fallback. When disabled
# (or no key), the older intent classifier fills the same role.
# JEV_ENABLED=true
JEV_API_KEY=
# ^ secret: set in Railway Variables, never commit (EXPERIENTIAL_API_KEY is
#   still read as a fallback name for older deployments)
# OpenCode Zen:        JEV_BASE_URL=https://opencode.ai/zen/v1/systemone  JEV_MODEL=jev-1.13-free
# Experiential Labs:   JEV_BASE_URL=https://api.experientiallabs.ai/v1/systemone  JEV_MODEL=jev-latest:free
# The model must end in :free or -free; anything else is refused.
# JEV_TIMEOUT_MS=8000
# JEV_ENGAGE_THRESHOLD=0.7
# Where Rivet engages is a per-program dashboard setting, not an env list.

# ─── behaviour (all optional) ────────────────────────────────────────────────

# Emoji the bot adds to a help-channel question the docs couldn't answer, as a
# flag for humans. Unset disables the handoff.
# RIVET_ESCALATE_REACTION=sos

# Emojis pre-placed on the bot's own answers so voting is one click. Off by
# default — a bot reacting to itself reads as self-congratulation, and votes
# people add themselves still count. Names must be ones the bot counts
# (UP_REACTIONS / DOWN_REACTIONS in lib/handlers.js).
# RIVET_FEEDBACK_REACTIONS=

# Where the weekly report goes. Defaults to the help channel. Unset with no
# help channel disables the scheduled post; the report command still works.
# RIVET_REPORT_CHANNEL=

# Replaces the built-in "who are you / what can you do" answers wholesale.
# Useful when the generated ones don't fit.
# RIVET_IDENTITY_OVERRIDE=

# Per-message debug logging. Verbose.
# RIVET_DEBUG=0

# ─── hosted shared mode (central @Rivet serving many programs) ──────────────

# Slack workspace (team) id all tenant boundaries scope to. Channel IDs repeat
# across workspaces, so hosted channel ownership, tickets, and dedupe key on
# workspace + channel/message. Single-workspace deployments may leave unset.
# RIVET_WORKSPACE_ID=T0000000000

# Shared secret for the Wizard → Core control-plane API (/internal/v1/*).
# Set a long random value; without it the internal API stays disabled and the
# Wizard dashboard cannot sync programs or act on tickets.
# RIVET_INTERNAL_TOKEN=

# ─── web console (optional, off unless SLACK_CLIENT_ID is set) ───────────────

# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# RIVET_WEB_URL=
# RIVET_WEB_PORT=4100
# Sign-in cookies. Without it a random one is generated per boot, so every
# restart logs everyone out.
# RIVET_SESSION_SECRET=
